<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Vista para la Calculadora de Distribución de Poisson.
    Sigue la plantilla estándar de 3 zonas y reutiliza la visualización
    de BarChart, manteniendo la máxima consistencia visual y de UX.
-->
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.calculos.controllers.PoissonController"
      spacing="15" styleClass="tab-content-area">
    <padding>
        <Insets top="10" right="20" bottom="20" left="20"/>
    </padding>

    <!-- === ZONA 1: PARÁMETROS DE ENTRADA === -->
    <VBox spacing="10" styleClass="content-pane">
        <Label text="1. Parámetro de la Distribución" styleClass="subtitle-label"/>
        <GridPane hgap="10" vgap="10">
            <Label text="Promedio de Ocurrencias (λ):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="lambdaField" promptText="Ej: 3" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <tooltip><Tooltip text="El número promedio de veces que ocurre el evento en un intervalo (debe ser un número positivo)."/></tooltip>
            </TextField>
        </GridPane>

        <Label text="2. Tipo de Cálculo" styleClass="subtitle-label" >
            <VBox.margin><Insets top="15.0"/></VBox.margin>
        </Label>
        <ComboBox fx:id="calculationTypeComboBox" prefWidth="Infinity"/>

        <GridPane hgap="10" vgap="10">
            <Label text="Ocurrencias (k/a):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="k1Field" promptText="Nº de eventos" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <tooltip><Tooltip text="Número de ocurrencias del evento a evaluar (debe ser un entero no negativo)."/></tooltip>
            </TextField>

            <Label fx:id="k2Label" text="Valor de b:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="k2Field" promptText="Límite superior del rango" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <tooltip><Tooltip text="Límite superior para el cálculo de rango P(a <= X <= b)."/></tooltip>
            </TextField>
        </GridPane>
    </VBox>

    <!-- === ZONA 2: ACCIONES === -->
    <HBox spacing="15" alignment="CENTER_RIGHT">
        <Button onAction="#onClear" styleClass="secondary-action-button" text="Limpiar">
            <graphic><FontIcon iconLiteral="mdi2b-broom" iconSize="18"/></graphic>
        </Button>
        <Button onAction="#onSolve" styleClass="primary-action-button" text="Calcular">
            <graphic><FontIcon iconLiteral="mdi2c-clock-fast" iconSize="18"/></graphic>
        </Button>
    </HBox>

    <!-- === ZONA 3: RESULTADOS Y VISUALIZACIÓN === -->
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Panel Izquierdo: Resultados Numéricos -->
        <VBox HBox.hgrow="NEVER">
            <Label text="Resultados Numéricos" styleClass="subtitle-label"/>
            <TextArea fx:id="resultArea" editable="false" wrapText="true" prefHeight="250" prefWidth="300"/>
        </VBox>

        <!-- Panel Derecho: Visualización Gráfica -->
        <VBox HBox.hgrow="ALWAYS">
            <Label text="Visualización de la Distribución" styleClass="subtitle-label"/>
            <BarChart fx:id="distributionChart" animated="false">
                <xAxis> <CategoryAxis label="Número de Ocurrencias (k)"/> </xAxis>
                <yAxis> <NumberAxis label="Probabilidad P(X=k)"/> </yAxis>
            </BarChart>
        </VBox>
    </HBox>
</VBox>