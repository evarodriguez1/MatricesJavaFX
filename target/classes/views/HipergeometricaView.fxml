<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.calculos.controllers.HipergeometricaController"
      spacing="15" alignment="TOP_CENTER" styleClass="tab-content">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Parámetros de la Población" styleClass="subtitle-label"/>
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Población Total (N):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="nField" promptText="Tamaño total del grupo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Éxitos Totales (K):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="kTotalField" promptText="Cantidad de éxitos en N" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Tamaño Muestra (n):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="nSampleField" promptText="Elementos a extraer" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    </GridPane>

    <Label text="Tipo de Probabilidad" styleClass="subtitle-label">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <ComboBox fx:id="calculationType" promptText="Selecciona un tipo de cálculo" prefWidth="250"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Valor de k (o a):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="k1Field" promptText="Número de éxitos buscado" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Valor de b (para rangos):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="k2Field" promptText="Solo necesario para P(a ≤ X ≤ b)" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
        <Button text="Calcular Probabilidad" onAction="#onSolve" styleClass="button"/>
        <Button text="Limpiar Campos" onAction="#onClear" styleClass="clear-button"/>
    </HBox>

    <Label text="Resultado y Otros Datos" styleClass="subtitle-label">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <TextArea fx:id="resultArea" editable="false" wrapText="true" prefHeight="150" prefWidth="400"/>

</VBox>