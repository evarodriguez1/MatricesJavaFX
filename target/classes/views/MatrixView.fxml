<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>


<?import javafx.scene.control.Label?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.calculos.controllers.MatrixController"
      spacing="10">

        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Módulo de Operaciones con Matrices" styleClass="title-label" />

            <Button text="← Volver al Menú Principal" onAction="#backToMenu" styleClass="clear-button"/>
        </VBox>

    <!-- Padding correcto usando Insets -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- GridPane con TextFields y botón -->
    <GridPane hgap="10" vgap="10">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <!-- Fila 1 -->
        <TextField fx:id="a11Field" GridPane.rowIndex="0" GridPane.columnIndex="0" promptText="a11"/>
        <TextField fx:id="a12Field" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="a12"/>
        <TextField fx:id="a13Field" GridPane.rowIndex="0" GridPane.columnIndex="2" promptText="a13"/>
        <TextField fx:id="b1Field"  GridPane.rowIndex="0" GridPane.columnIndex="3" promptText="b1"/>

        <!-- Fila 2 -->
        <TextField fx:id="a21Field" GridPane.rowIndex="1" GridPane.columnIndex="0" promptText="a21"/>
        <TextField fx:id="a22Field" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="a22"/>
        <TextField fx:id="a23Field" GridPane.rowIndex="1" GridPane.columnIndex="2" promptText="a23"/>
        <TextField fx:id="b2Field"  GridPane.rowIndex="1" GridPane.columnIndex="3" promptText="b2"/>

        <!-- Fila 3 -->
        <TextField fx:id="a31Field" GridPane.rowIndex="2" GridPane.columnIndex="0" promptText="a31"/>
        <TextField fx:id="a32Field" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="a32"/>
        <TextField fx:id="a33Field" GridPane.rowIndex="2" GridPane.columnIndex="2" promptText="a33"/>
        <TextField fx:id="b3Field"  GridPane.rowIndex="2" GridPane.columnIndex="3" promptText="b3"/>

        <!-- Botón Limpiar -->
        <Button text="Limpiar" onAction="#onClear"
                GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2"
                styleClass="clear-button" />

        <!-- Botón Resolver -->
        <Button text="Resolver" onAction="#onSolve"
                GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
    </GridPane>

    <!-- TextArea para resultados -->
    <TextArea fx:id="resultArea" editable="false" wrapText="true" prefHeight="150"/>
</VBox>
