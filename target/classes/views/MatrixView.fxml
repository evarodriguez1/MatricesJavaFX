<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    VISTA FINAL DE MATRICES
    Autor: Luca (Arquitecto de Software)
    Descripción:
    - Fusiona la estructura simple del FXML actual con las mejoras de UX y layout de la versión avanzada.
    - Sigue el patrón MVC y aplica estrictamente las clases de 'styles.css'.
    - Introduce botones para 'Rellenar Ceros', 'Limpiar', y 'Volver'.
-->

<VBox spacing="20" styleClass="root" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.calculos.controllers.MatrixController">
    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>

    <!-- === 1. CABECERA DE LA VISTA === -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#backToMenu" styleClass="secondary-button" text="← Volver al Menú" />
        <Label styleClass="title-label" text="Resolución de Sistemas de Ecuaciones (3x3)" />
    </HBox>

    <!-- === 2. ZONA DE ENTRADA DE DATOS (FORMULARIO) === -->
    <VBox spacing="15" styleClass="content-pane">
        <Label styleClass="subtitle-label" text="1. Ingrese los coeficientes del sistema" />

        <GridPane alignment="CENTER" hgap="10" vgap="10">
            <!-- Definimos las columnas para un control preciso del layout -->
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="NEVER" prefWidth="2.0" /> <!-- Columna para la línea vertical -->
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
            </columnConstraints>

            <!-- Cabeceras de Columna para una UX clara -->
            <Label styleClass="label" text="X₁" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="X₂" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="X₃" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="b" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

            <!-- Fila 1 de TextFields -->
            <TextField fx:id="a11Field" promptText="[1,1]" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="a12Field" promptText="[1,2]" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="a13Field" promptText="[1,3]" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="b1Field" promptText="[1,b]" GridPane.columnIndex="4" GridPane.rowIndex="1" />

            <!-- Fila 2 de TextFields -->
            <TextField fx:id="a21Field" promptText="[2,1]" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="a22Field" promptText="[2,2]" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="a23Field" promptText="[2,3]" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="b2Field" promptText="[2,b]" GridPane.columnIndex="4" GridPane.rowIndex="2" />

            <!-- Fila 3 de TextFields -->
            <TextField fx:id="a31Field" promptText="[3,1]" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="a32Field" promptText="[3,2]" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="a33Field" promptText="[3,3]" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="b3Field" promptText="[3,b]" GridPane.columnIndex="4" GridPane.rowIndex="3" />

            <!-- Línea Vertical Separadora -->
            <Pane style="-fx-background-color: -fx-color-secondary-purple;" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowSpan="4" />
         <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
         </rowConstraints>
        </GridPane>
    </VBox>

    <!-- === 3. ZONA DE ACCIONES === -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button onAction="#onFillWithZeros" styleClass="secondary-button" text="Rellenar celdas vacías con ceros" />
        <Pane HBox.hgrow="ALWAYS" /> <!-- Empuja los siguientes botones a la derecha -->
        <Button onAction="#onClear" styleClass="secondary-button" text="Limpiar" />
        <Button fx:id="solveButton" onAction="#onSolve" styleClass="primary-button" text="Resolver" />
    </HBox>

    <!-- === 4. ZONA DE RESULTADOS === -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label styleClass="subtitle-label" text="Resultados del Análisis" />
        <TextArea fx:id="resultArea" editable="false" styleClass="result-area" wrapText="true" VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>
