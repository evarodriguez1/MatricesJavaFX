<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.calculos.controllers.RootController"
      alignment="CENTER"
      spacing="20"
      styleClass="root-menu">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Selecciona un Módulo de Cálculo" styleClass="title-label">
        <font>
            <Font size="20.0" />
        </font>
    </Label>

    <VBox spacing="15" alignment="CENTER">
        <Button text="1. Estadísticas" onAction="#openStatisticsView" prefWidth="250" />
        <Button text="2. Probabilidades" onAction="#openProbabilityView" prefWidth="250" />
        <Button text="3. Matrices (Gauss-Jordan)" onAction="#openMatrixView" prefWidth="250" />
    </VBox>
</VBox>
