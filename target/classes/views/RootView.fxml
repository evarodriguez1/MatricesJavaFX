<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Vista del Menú Principal (Root).
    VERSIÓN CORREGIDA: Se han actualizado los literales de los iconos a la
    sintaxis correcta de Ikonli para evitar errores de carga.
-->
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.calculos.controllers.RootController"
      alignment="CENTER" spacing="30" styleClass="root" prefHeight="650" prefWidth="800">

    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <!-- TÍTULO PRINCIPAL DE LA APLICACIÓN -->
    <Label text="Calculadora de Matemática Aplicada" styleClass="title-label"/>

    <Label text="Selecciona el módulo con el que deseas trabajar:" styleClass="label">
        <VBox.margin>
            <Insets top="10" bottom="20"/>
        </VBox.margin>
    </Label>

    <!-- CONTENEDOR DE BOTONES DE NAVEGACIÓN -->
    <VBox spacing="20" alignment="CENTER" maxWidth="400">

        <!-- Botón para Estadísticas -->
        <Button text="Estadística Descriptiva" onAction="#openStatisticsView"
                styleClass="primary-action-button" maxWidth="Infinity">
            <graphic>
                <!-- CORREGIDO: "mdi2c-chart-bar" -> "mdi-chart-bar" -->
                <FontIcon iconLiteral="mdi-chart-bar" iconSize="20"/>
            </graphic>
        </Button>

        <!-- Botón para Probabilidades -->
        <Button text="Cálculos de Probabilidad" onAction="#openProbabilityView"
                styleClass="primary-action-button" maxWidth="Infinity">
            <graphic>
                <!-- CORREGIDO: "mdi2d-dice-multiple" -> "mdi-dice-multiple" -->
                <FontIcon iconLiteral="mdi-dice-multiple" iconSize="20"/>
            </graphic>
        </Button>

        <!-- Botón para Matrices -->
        <Button text="Resolución de Matrices" onAction="#openMatrixView"
                styleClass="primary-action-button" maxWidth="Infinity">
            <graphic>
                <!-- CORREGIDO: "mdi2m-matrix" -> "mdi-matrix" -->
                <FontIcon iconLiteral="mdi-matrix" iconSize="20"/>
            </graphic>
        </Button>
    </VBox>
</VBox>