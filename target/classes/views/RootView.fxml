<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Vista del Menú Principal (Root) - Versión 3.0 RESPONSIVA -->
<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.calculos.controllers.RootController"
            styleClass="root">

    <!-- Este VBox se expandirá siempre para llenar el AnchorPane -->
    <VBox alignment="CENTER" spacing="30"
          AnchorPane.topAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0">

        <padding>
            <Insets top="50" right="50" bottom="50" left="50"/>
        </padding>

        <Label text="Calculadora de Matemática Aplicada" styleClass="title-label"/>
        <Label text="Selecciona el módulo con el que deseas trabajar:" styleClass="label">
            <VBox.margin>
                <Insets top="10" bottom="20"/>
            </VBox.margin>
        </Label>

        <VBox spacing="20" alignment="CENTER" maxWidth="400">
            <Button text="Estadística Descriptiva" onAction="#openStatisticsView"
                    styleClass="primary-action-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="mdi2c-chart-bar" iconSize="20"/></graphic>
            </Button>
            <Button text="Cálculos de Probabilidad" onAction="#openProbabilityView"
                    styleClass="primary-action-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="mdi2d-dice-multiple" iconSize="20"/></graphic>
            </Button>
            <Button text="Resolución de Matrices" onAction="#openMatrixView"
                    styleClass="primary-action-button" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="mdi2m-matrix" iconSize="20"/></graphic>
            </Button>
        </VBox>
    </VBox>
</AnchorPane>