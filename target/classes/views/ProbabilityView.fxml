<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Vista Contenedora del Módulo de Probabilidades - Versión 2.1 FINAL -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.calculos.controllers.ProbabilityController" styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20px;">
            <Button onAction="#backToMenu" styleClass="navigation-button">
                <graphic><FontIcon iconLiteral="mdi2a-arrow-left-bold-circle-outline" iconSize="32" iconColor="#EDE7F6"/></graphic>
                <tooltip><Tooltip text="Volver al Menú Principal"/></tooltip>
            </Button>
            <Label text="Módulo de Probabilidades" styleClass="title-label" />
        </HBox>
    </top>

    <center>
        <TabPane fx:id="probabilityTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <!--
                CORRECCIÓN ESTRUCTURAL: El padding se aplica aquí para que el
                TabPane mismo tenga un margen, permitiendo que su contenido
                (las vistas de cálculo) se expanda completamente.
            -->
            <padding>
                <Insets top="0" right="20" bottom="20" left="20"/>
            </padding>
            <Tab fx:id="binomialTab" text="Binomial"/>
            <Tab fx:id="normalTab" text="Normal"/>
            <Tab fx:id="hypergeometricTab" text="Hipergeométrica"/>
            <Tab fx:id="poissonTab" text="Poisson"/>
        </TabPane>
    </center>
</BorderPane>