<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.calculos.controllers.MatrixController"
      spacing="20" styleClass="root">
    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <Button onAction="#backToMenu" styleClass="secondary-action-button" text="← Volver al Menú" />
        <Label styleClass="title-label" text="Resolución de Sistemas de Ecuaciones (3x3)" />
    </HBox>

    <VBox spacing="15" styleClass="content-pane">
        <Label styleClass="subtitle-label" text="1. Ingrese los coeficientes del sistema" />

        <GridPane alignment="CENTER" hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
                <ColumnConstraints hgrow="NEVER" prefWidth="2.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="80.0" />
            </columnConstraints>
            <Label styleClass="label" text="X₁" GridPane.columnIndex="0" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="Y₂" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="Z₃" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="0" />
            <Label styleClass="label" text="b" GridPane.columnIndex="4" GridPane.halignment="CENTER" GridPane.rowIndex="0" />

            <!-- ✅ CORRECCIÓN APLICADA: promptText actualizado a formato [fila,columna] -->
            <TextField fx:id="a11Field" promptText="[1,1]" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="a12Field" promptText="[1,2]" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <TextField fx:id="a13Field" promptText="[1,3]" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <TextField fx:id="b1Field" promptText="[1,4]" GridPane.columnIndex="4" GridPane.rowIndex="1" />

            <TextField fx:id="a21Field" promptText="[2,1]" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="a22Field" promptText="[2,2]" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <TextField fx:id="a23Field" promptText="[2,3]" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <TextField fx:id="b2Field" promptText="[2,4]" GridPane.columnIndex="4" GridPane.rowIndex="2" />

            <TextField fx:id="a31Field" promptText="[3,1]" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <TextField fx:id="a32Field" promptText="[3,2]" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <TextField fx:id="a33Field" promptText="[3,3]" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <TextField fx:id="b3Field" promptText="[3,4]" GridPane.columnIndex="4" GridPane.rowIndex="3" />

            <Pane style="-fx-background-color: #00BFFF;" GridPane.columnIndex="3" GridPane.halignment="CENTER" GridPane.rowSpan="4" />

            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>
    </VBox>

    <HBox alignment="CENTER_LEFT" spacing="15">
        <Button onAction="#onFillWithZeros" styleClass="secondary-action-button" text="Rellenar Ceros" />
        <CheckBox fx:id="useFractionsCheck" selected="true" text="Usar cálculo exacto (fracciones)" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#onClear" styleClass="secondary-action-button" text="Limpiar" />
        <Button fx:id="solveButton" onAction="#onSolve" styleClass="primary-action-button" text="Resolver Sistema" />
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="subtitle-label" text="Resultados del Análisis" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button fx:id="checkButton" onAction="#onCheckSolution" styleClass="secondary-button" text="Corroborar Solución ✔" />
            <Button fx:id="showStepsButton" onAction="#onShowSteps" styleClass="secondary-action-button" text="Ver Paso a Paso ⚙" />
        </HBox>
        <TextArea fx:id="resultArea" editable="false" styleClass="result-area" wrapText="true" VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>