<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calculos.controllers.StatisticsController"
            prefHeight="750.0" prefWidth="900.0" styleClass="root">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Módulo de Estadísticas Descriptivas" styleClass="title-label" />
            <Button text="← Volver al Menú Principal" onAction="#backToMenu" styleClass="clear-button"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

            <Label text="1. Ingreso de Datos" styleClass="subtitle-label"/>

            <GridPane hgap="10" vgap="10" alignment="CENTER">
                <Label text="Tipo de Datos:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="dataTypeComboBox" promptText="Selecciona el tipo" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Lista de Números (separados por espacio o coma):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="dataInputField" promptText="Ej: 1, 2.5, 3, 4.2" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
                <Button text="Calcular TODAS las Estadísticas" onAction="#onSolveAll" styleClass="button"/>
                <Button text="Limpiar Datos y Resultados" onAction="#onClear" styleClass="clear-button"/>
            </HBox>

            <Label text="Opciones de Visualización (Cálculo Detallado)" styleClass="subtitle-label">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </Label>
            <ComboBox fx:id="resultTypeComboBox" promptText="Selecciona qué sección ver" prefWidth="300" onAction="#onSolveSpecific"/>

            <Label text="2. Resultados" styleClass="subtitle-label">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </Label>
            <TextArea fx:id="resultArea" editable="false" wrapText="true" prefHeight="400" prefWidth="800"/>

        </VBox>
    </center>
</BorderPane>