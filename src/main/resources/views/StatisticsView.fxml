<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Vista para el Módulo de Estadística Descriptiva.
    - Se añade maxWidth="Infinity" a los componentes clave para forzar la expansión.
    - Se optimiza la estructura para garantizar la correcta renderización.
-->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.calculos.controllers.StatisticsController"
      spacing="15" styleClass="root">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <!-- === CABECERA DE LA VISTA === -->
    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 0 10 0;">
        <Button onAction="#backToMenu" styleClass="navigation-button">
            <graphic><FontIcon iconLiteral="mdi2a-arrow-left-bold-circle-outline" iconSize="32" iconColor="#EDE7F6"/></graphic>
            <tooltip><Tooltip text="Volver al Menú Principal"/></tooltip>
        </Button>
        <Label text="Módulo de Estadística Descriptiva" styleClass="title-label" />
    </HBox>

    <!-- === ZONA 1: ENTRADA DE DATOS === -->
    <VBox spacing="10" styleClass="content-pane">
        <Label text="1. Ingreso del Conjunto de Datos" styleClass="subtitle-label"/>
        <GridPane hgap="15" vgap="10">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Tipo de Datos:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <!-- maxWidth="Infinity" fuerza al ComboBox a expandirse. -->
            <ComboBox fx:id="dataTypeComboBox" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Lista de Números:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <!-- maxWidth="Infinity" fuerza al TextField a expandirse. -->
            <TextField fx:id="dataInputField" styleClass="data-input-field"
                       disable="true" maxWidth="Infinity"
                       promptText="Selecciona un Tipo de Datos para empezar..." GridPane.columnIndex="1" GridPane.rowIndex="1">
                <tooltip><Tooltip text="Pega aquí tu lista de datos numéricos. Por ejemplo: 1.5 2,3; 4 5.1"/></tooltip>
            </TextField>
        </GridPane>
    </VBox>

    <!-- === ZONA 2: ACCIONES === -->
    <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 15 0 0 0;">
        <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="resultTypeComboBox" prefWidth="280" promptText="Calcular sección específica..."/>
            <Button onAction="#onSolveSpecific" styleClass="primary-action-button" text="Calcular">
                <graphic><FontIcon iconLiteral="mdi2c-cursor-default-click" iconSize="18"/></graphic>
                <tooltip><Tooltip text="Calcular la sección seleccionada"/></tooltip>
            </Button>
        </HBox>
        <Button onAction="#onSolveAll" styleClass="secondary-action-button" text="Analizar Todo">
            <graphic><FontIcon iconLiteral="mdi2m-magnify" iconSize="18"/></graphic>
        </Button>
        <Button onAction="#onClear" styleClass="tertiary-action-button" text="Limpiar">
            <graphic><FontIcon iconLiteral="mdi2b-broom" iconSize="18"/></graphic>
        </Button>
    </HBox>

    <!-- === ZONA 3: RESULTADOS === -->
    <VBox VBox.vgrow="ALWAYS" spacing="5" style="-fx-padding: 10 0 0 0;">
        <Label text="2. Resultados del Análisis" styleClass="subtitle-label"/>
        <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS">
            <content>
                <TextArea fx:id="resultArea" editable="false" wrapText="true"/>
            </content>
        </ScrollPane>
    </VBox>
</VBox>