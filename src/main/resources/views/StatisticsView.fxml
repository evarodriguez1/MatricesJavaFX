<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calculos.controllers.StatisticsController"
            prefHeight="750.0" prefWidth="900.0" styleClass="root">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Módulo de Estadísticas Descriptivas" styleClass="title-label"/>
            <Button text="← Volver al Menú Principal" onAction="#backToMenu" styleClass="secondary-action-button"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="40" alignment="TOP_CENTER">
            <padding>
                <Insets top="80" right="40" bottom="20" left="40"/>
            </padding>

            <VBox spacing="20" alignment="CENTER" maxWidth="800">
                <Label text="1. Ingreso de Datos" styleClass="subtitle-label"/>

                <GridPane hgap="15" vgap="15" alignment="CENTER">
                    <Label text="Tipo de Datos:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <ComboBox fx:id="dataTypeComboBox" promptText="Selecciona el tipo de dato" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Lista de Números:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <TextField fx:id="dataInputField" promptText="Primero selecciona un tipo" disable="true" prefWidth="300" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <HBox spacing="20" alignment="CENTER">
                <Button text="Calcular Estadísticas" onAction="#onSolveAll" styleClass="primary-action-button"/>
                <Button text="Limpiar Campos" onAction="#onClear" styleClass="secondary-action-button"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>