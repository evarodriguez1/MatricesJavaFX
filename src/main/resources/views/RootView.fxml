<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.calculos.controllers.RootController"
           styleClass="root-menu">

    <VBox alignment="CENTER" spacing="20">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        <Label text="Selecciona un Módulo de Cálculo" styleClass="title-label"/>
        <VBox spacing="15" alignment="CENTER">
            <Button text="1. Estadísticas" onAction="#openStatisticsView" prefWidth="350"/>
            <Button text="2. Probabilidades" onAction="#openProbabilityView" prefWidth="350"/>
            <Button text="3. Matrices (Gauss-Jordan)" onAction="#openMatrixView" prefWidth="350"/>
            <Button text="4. Área de regiones curvas" onAction="#openQuadraticAreaView" prefWidth="350"/>
        </VBox>
    </VBox>

    <Button fx:id="muteButton" onAction="#toggleMute" styleClass="mute-button" StackPane.alignment="BOTTOM_RIGHT">
        <graphic>
            <!-- Cambiamos FontIcon por ImageView, el componente nativo de JavaFX para imágenes -->
            <ImageView fx:id="muteIconImageView" fitHeight="50" fitWidth="50" pickOnBounds="true" preserveRatio="true"/>
        </graphic>
        <StackPane.margin>
            <Insets bottom="15" right="15"/>
        </StackPane.margin>
    </Button>
</StackPane>