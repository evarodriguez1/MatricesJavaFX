<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!--
    Vista del Módulo de Probabilidades.
    Utiliza un BorderPane para la estructura principal y un TabPane
    para la navegación entre las diferentes distribuciones.

    IMPORTANTE: Los <Tab> están deliberadamente VACÍOS. Su contenido
    será cargado dinámicamente ("Lazy Loading") por el ProbabilityController
    la primera vez que se haga clic en ellos. Esto optimiza el rendimiento.
-->
<?import javafx.scene.control.Tooltip?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.calculos.controllers.ProbabilityController"
            styleClass="root">

    <!-- === CABECERA DE LA VISTA === -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20px;">
            <!-- Botón de Navegación para Volver -->
            <Button onAction="#backToMenu" styleClass="navigation-button">
                <graphic>
                    <FontIcon iconLiteral="mdi2a-arrow-left-bold-circle-outline" iconSize="32" iconColor="#EDE7F6"/>
                </graphic>
                <tooltip>
                    <Tooltip text="Volver al Menú Principal"/>
                </tooltip>
            </Button>

            <!-- Título de la Sección -->
            <Label text="Módulo de Probabilidades" styleClass="title-label" />
        </HBox>
    </top>

    <!-- === CONTENIDO PRINCIPAL (PESTAÑAS) === -->
    <center>
        <TabPane fx:id="probabilityTabPane" tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets left="20" right="20" bottom="20"/>
            </BorderPane.margin>
            <!--
                fx:id se usa para que el Controller pueda identificarlas y
                añadirles los listeners para la carga perezosa.
                El contenido se carga en el código, no aquí.
            -->
            <Tab fx:id="binomialTab" text="Binomial"/>
            <Tab fx:id="normalTab" text="Normal"/>
            <Tab fx:id="hypergeometricTab" text="Hipergeométrica"/>
            <Tab fx:id="poissonTab" text="Poisson"/>
        </TabPane>
    </center>
</BorderPane>