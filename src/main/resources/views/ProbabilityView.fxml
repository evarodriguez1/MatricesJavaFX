<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.calculos.controllers.ProbabilityController"
            prefHeight="600.0" prefWidth="800.0" styleClass="root">

    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <Label text="Módulo de Probabilidades" styleClass="title-label" />
            <Button text="← Volver al Menú Principal" onAction="#backToMenu" styleClass="clear-button"/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="probabilityTabPane" side="TOP" tabClosingPolicy="UNAVAILABLE">

            <Tab text="Distribución Binomial">
                <fx:include source="BinomialView.fxml"/>
            </Tab>

            <Tab text="Distribución Normal (Gaussiana)">
                <fx:include source="GaussianaView.fxml"/>
            </Tab>

            <Tab text="Distribución Hipergeométrica">
                <fx:include source="HipergeometricaView.fxml"/>
            </Tab>

            <Tab text="Distribución de Poisson">
                <fx:include source="PoissonView.fxml"/>
            </Tab>

        </TabPane>
    </center>
</BorderPane>