<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.calculos.controllers.GaussianaController"
      spacing="15" alignment="TOP_CENTER" styleClass="tab-content">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Parámetros (μ y σ²)" styleClass="subtitle-label"/>
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Media (μ):" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="mediaField" promptText="Promedio de los datos" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Varianza (σ²):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="varianzaField" promptText="Dispersión" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Label text="Tipo de Probabilidad" styleClass="subtitle-label">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <ComboBox fx:id="calculationType" promptText="Selecciona un tipo de cálculo" prefWidth="250"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Punto 'a':" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="aField" promptText="Valor de x (límite inferior)" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Punto 'b' (opcional):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="bField" promptText="Límite superior (solo para rangos)" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
        <Button text="Calcular Probabilidad" onAction="#onSolve" styleClass="button"/>
        <Button text="Limpiar Campos" onAction="#onClear" styleClass="clear-button"/>
    </HBox>

    <Label text="Resultado y Z-Scores" styleClass="subtitle-label">
        <VBox.margin>
            <Insets top="10.0"/>
        </VBox.margin>
    </Label>
    <TextArea fx:id="resultArea" editable="false" wrapText="true" prefHeight="150" prefWidth="400"/>

</VBox>